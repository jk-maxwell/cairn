# ---------------------------------------------------------------------------
# Cairn: what must never be committed.
#
# Rule two of the product is "nothing leaves the machine." In a public repo that
# rule has teeth only if the ignore list has teeth. Everything below is either
# user content, derived user content, or a local secret. None of it belongs in
# version control, and none of it belongs on a remote.
#
# This is an allow-nothing list for data, not a tidy-up list. If you are adding
# an exception here, stop and be sure.
# ---------------------------------------------------------------------------

# --- user content and everything derived from it ---------------------------
# NOTE: git treats "#" as a comment only at the start of a line. An inline
# comment becomes part of the pattern and silently kills it — keep every
# comment on its own line.
# documents the user deliberately saved
sources/
# converted markdown of those documents
vault/
# cairn.db and any sibling database
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# local speed log; metrics only, but it is machine-local
benchmarks.csv
# governance event log: the ratification-burden instrument. Carries entity_id
# hashes and never names, but it is a record of this user's structure decisions
# and their timing. Machine-local.
governance.csv
# ratification-burden readings appended by selftest.py; counts only
burden.csv
# local gate output
gates.txt
_ingest_failures.log

# --- session and working artifacts -----------------------------------------
# Continuity handoff notes. They quote vault structure, entity names, defect
# reproductions and open design questions -- working material, and none of it
# belongs on a remote. Each one already carries a "never commit this file"
# header; this is the pattern that enforces it.
continuity_*.md
# scratch worktrees created by the task runner
.claudia-worktrees/

# --- transfer artifacts from the pre-git working method --------------------
*.zip
cargo*/
backup-*/

# --- local tooling and machine-specific config -----------------------------
.claude/
.mcp.json
.env
.env.*
*.local.*
node_modules/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- editors and operating systems -----------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# probe receipt log: real questions, user content
probe-*.log
